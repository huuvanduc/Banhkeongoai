NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/banhkeongoai
DATABASE_SSL=false
PUBLIC_ORIGIN=http://localhost:3000
SESSION_DAYS=7
# Set true only behind a trusted HTTPS reverse proxy.
TRUST_PROXY=false

# Orders stay disabled until the admin settings record is complete and both
# integrations below are configured. Never commit real credentials.
PAYMENT_PROVIDER=disabled
PAYMENT_CHECKOUT_URL=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
SHIPPING_PROVIDER=disabled
SHIPPING_QUOTE_URL=
SHIPPING_API_KEY=
